--- /dev/null
+++ b/src/audio_mixer_lock.hpp
@@ -0,0 +1,13 @@
+#pragma once
+
+#include <godot_cpp/classes/audio_server.hpp>
+
+// Godot uses a recursive driver mutex, so this also protects direct calls made
+// outside the mix thread and can nest inside AudioStreamPlayer methods.
+class AudioMixerLock {
+public:
+    AudioMixerLock() { godot::AudioServer::get_singleton()->lock(); }
+    ~AudioMixerLock() { godot::AudioServer::get_singleton()->unlock(); }
+    AudioMixerLock(const AudioMixerLock &) = delete;
+    AudioMixerLock &operator=(const AudioMixerLock &) = delete;
+};
